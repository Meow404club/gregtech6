  "neoforge-api": {
    "root": "tmp/refs/neoforge-api/neoforge-1.20.1/src/main/java",
    "lang": "java",
    "include": [
      "**/*.java"
    ],
    "exclude": [],
    "desc": "NeoForge 1.20.1 API 源码"
  },
  "forge-docs": {
    "root": "tmp/refs/forge-docs",
    "lang": "md",
    "include": [
      "**/docs/**/*.md"
    ],
    "exclude": [
      "**/CHANGELOG*",
      "**/LICENSE*"
    ],
    "desc": "MinecraftForge 官方文档（1.12.x～1.21.x 各分支）"
  },
  "neoforge-docs": {
    "root": "tmp/refs/neoforge-docs/neoforge",
    "lang": "md",
    "include": [
      "docs/**/*.md",
      "primer/**/*.md",
      "modpack/**/*.md"
    ],
    "exclude": [],
    "desc": "NeoForge 官方文档（当前版本文档站）"
  },
  "project": {
    "root": ".",
    "lang": "auto",
    "include": [
      "docs/*.md",
      "docs/**/*.md",
      "AGENTS.md",
      "src/main/java/**/*.java",
      "src/test/java/**/*.java",
      "mdk/src/main/java/**/*.java",
      "mdk/src/test/java/**/*.java",
      "tools/*.py",
      "tools/**/*.py"
    ],
    "exclude": [
      "tmp/**",
      "tools/.venv/**"
    ],
    "prune": [
      "tmp",
      "generated",
      "run",
      "out",
      ".venv",
      "__pycache__",
      ".zcode",
      ".githooks",
      "gradle"
    ],
    "desc": "本项目移植仓库本体：根 gregapi(src/) + mdk 1.20.1 模块 Java 源码与单测 + tools 工具链 + docs/AGENTS 决策文档"
  },
  "harvest": {
    "root": "tmp/harvest",
    "lang": "auto",
    "include": [
      "**/*.java",
      "**/*.md",
      "**/*.py",
      "**/*.js",
      "**/*.mjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.go",
      "**/*.rs",
      "**/*.c",
      "**/*.h",
      "**/*.cpp",
      "**/*.cc",
      "**/*.hpp",
      "**/*.txt",
      "**/*.json",
      "**/*.yaml",
      "**/*.yml",
      "**/*.toml",
      "**/*.kts",
      "**/*.kt",
      "**/*.flex",
      "**/*.gradle",
      "**/*.properties"
    ],
    "exclude": [
      "**/meta.json"
    ],
    "desc": "researcher 收割的外部参考资料（harvest 工具写入；主 agent 审查 meta 后 refresh_index(source='harvest') 增量入 RAG）"
  }
}