# 外部资料与生成物（体积大，不入库）
tmp/
tools/.venv/
tools/**/__pycache__/

# 本地密钥覆盖（若以后把 config.json 提交到远端，先迁移走密钥）
.zcode/config.local.json

# IDE
.idea/
.vscode/

# 密钥文件（pre-commit 强制拦截）
tools/config.json

# Gradle
.gradle/
build/

# Mod dev 运行目录（runClient/runServer/runData 工作目录，含世界数据）
mdk/run/

# DataGenerator HashCache 本地账本（含运行时间戳，跨机器伪 diff；产物 JSON 本体已入库）
mdk/src/generated/resources/.cache/

# 客户端/服务端运行日志（会话时间戳，无入库价值）
mdk/logs/

# P15 石匠节点运行目录（runClient/runServer/runData，游戏库与世界数据不入库；
# 节点 build/ 与 stonecutter cache 由全局 build//.gradle/ 规则覆盖）
mdk/versions/*/run/
mdk/versions/*/logs/
